# Copia este archivo a .env y reemplaza estos valores de ejemplo.
# No uses estos valores de ejemplo en producción.
DB_USERNAME=sura_app
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA
APP_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
APP_ANALISTA_PASSWORD=
APP_ADMIN_PASSWORD=
APP_BOOTSTRAP_USERS_ENABLED=false
APP_CORS_ALLOWED_ORIGIN=http://localhost:8081
APP_PORT=8081
# Opcional: deja vacío para que RugIA no llame a Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15
APP_RATE_LIMIT_API_PER_MINUTE=120
APP_RATE_LIMIT_LOGIN_PER_MINUTE=10
